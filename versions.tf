terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.60"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.31"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.14"
    }
  }

  # Uncomment and configure to keep state off your laptop (recommended once
  # you're past initial testing):
  #
  # backend "s3" {
  #   bucket         = "your-terraform-state-bucket"
  #   key            = "k8s-ai-troubleshooter/eks/terraform.tfstate"
  #   region         = "us-east-1"
  #   dynamodb_table = "terraform-locks"
  #   encrypt        = true
  # }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "k8s-ai-troubleshooter"
      ManagedBy   = "terraform"
      Environment = var.environment
    }
  }
}

# The kubernetes/helm providers authenticate to the cluster this same apply
# creates, using a short-lived token from the AWS CLI — no separate
# `aws eks update-kubeconfig` step needed for Terraform-managed resources
# (e.g. if you later add Helm releases here). kubectl/the dashboard itself
# still needs a real kubeconfig — see README.md.
provider "kubernetes" {
  host                   = module.eks.cluster_endpoint
  cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)

  exec {
    api_version = "client.authentication.k8s.io/v1beta1"
    command     = "aws"
    args        = ["eks", "get-token", "--cluster-name", module.eks.cluster_name, "--region", var.aws_region]
  }
}

provider "helm" {
  kubernetes {
    host                   = module.eks.cluster_endpoint
    cluster_ca_certificate = base64decode(module.eks.cluster_certificate_authority_data)

    exec {
      api_version = "client.authentication.k8s.io/v1beta1"
      command     = "aws"
      args        = ["eks", "get-token", "--cluster-name", module.eks.cluster_name, "--region", var.aws_region]
    }
  }
}
